    {"action": "request", "label": "colocated", "request": {"op": "conditional_txn", "txn_id": "ct-colocated", "expected": {"a": 95, "b": 107}, "delta_map": {"a": 2, "b": -2}}},
    {"action": "await", "label": "colocated", "max_rounds": 10000},
    {"action": "crash", "worker": "b"},
    {"action": "restart", "worker": "b"},
    {"action": "request", "label": "cross-retry-after-restart", "request": {"op": "conditional_txn", "txn_id": "ct-cross-ok", "expected": {"a": 101, "b": 100}, "delta_map": {"a": -7, "b": 7}}},
    {"action": "await", "label": "cross-retry-after-restart", "max_rounds": 10000},
    {"action": "assert_response", "label": "cross-retry-after-restart", "equals": {"txn_id": "ct-cross-ok", "status": "COMMITTED"}},
    {"action": "request", "label": "final", "request": {"op": "snapshot", "read_id": "conditional-final", "keys": ["a", "b", "c"]}},
