{
  "initial": {
    "keys": {"a": 100, "b": 100, "c": 0},
    "key_shards": {"a": "A", "b": "B", "c": "C"}
  },
  "steps": [
    {"action": "request", "label": "single-ok", "request": {"op": "conditional_txn", "txn_id": "ct-single-ok", "expected": {"a": 100}, "delta_map": {"a": 1}}},
    {"action": "await", "label": "single-ok", "max_rounds": 1000},
    {"action": "assert_response", "label": "single-ok", "equals": {"txn_id": "ct-single-ok", "status": "COMMITTED"}},
    {"action": "request", "label": "single-retry", "request": {"op": "conditional_txn", "txn_id": "ct-single-ok", "expected": {"a": 100}, "delta_map": {"a": 1}}},
    {"action": "await", "label": "single-retry", "max_rounds": 1000},
    {"action": "assert_response", "label": "single-retry", "equals": {"txn_id": "ct-single-ok", "status": "COMMITTED"}},
    {"action": "request", "label": "single-no", "request": {"op": "conditional_txn", "txn_id": "ct-single-no", "expected": {"a": 100}, "delta_map": {"a": 9}}},
