    {"action": "assert_response", "label": "single-no", "equals": {"txn_id": "ct-single-no", "status": "ABORTED"}},
    {"action": "request", "label": "single-no-status", "request": {"op": "status", "txn_id": "ct-single-no"}},
    {"action": "await", "label": "single-no-status", "max_rounds": 1000},
    {"action": "assert_response", "label": "single-no-status", "equals": {"txn_id": "ct-single-no", "status": "ABORTED"}},
    {"action": "request", "label": "cross-ok", "request": {"op": "conditional_txn", "txn_id": "ct-cross-ok", "expected": {"a": 101, "b": 100}, "delta_map": {"a": -7, "b": 7}}},
    {"action": "await", "label": "cross-ok", "max_rounds": 10000},
    {"action": "assert_response", "label": "cross-ok", "equals": {"txn_id": "ct-cross-ok", "status": "COMMITTED"}},
    {"action": "request", "label": "cross-no", "request": {"op": "conditional_txn", "txn_id": "ct-cross-no", "expected": {"a": 101, "b": 107}, "delta_map": {"a": 5, "b": -5}}},
    {"action": "await", "label": "cross-no", "max_rounds": 10000},
    {"action": "assert_response", "label": "cross-no", "equals": {"txn_id": "ct-cross-no", "status": "ABORTED"}},
    {"action": "request", "label": "condition-only-key", "request": {"op": "conditional_txn", "txn_id": "ct-condition-key", "expected": {"b": 107}, "delta_map": {"a": 1}}},
