{
  "initial": {
    "keys": {"a": 100, "b": 100, "c": 0},
    "key_shards": {"a": "A", "b": "B", "c": "C"}
  },
  "steps": [
    {"action": "network_rule", "rule": {"type": "READ_RELEASE", "duplicate": 1, "late_duplicate": 180, "count": 1}},
    {"action": "request", "label": "read", "request": {"op": "snapshot", "read_id": "read-release-duplicate", "keys": ["a", "b"]}},
    {"action": "await", "label": "read", "max_rounds": 1000},
    {"action": "assert_values", "label": "read", "equals": {"a": 100, "b": 100}},
    {"action": "crash", "worker": "coord"},
    {"action": "restart", "worker": "coord"},
    {"action": "rounds", "count": 220},
    {"action": "request", "label": "healthy-write", "request": {"op": "txn", "txn_id": "late-release-write", "delta_map": {"a": 1}}},
    {"action": "await", "label": "healthy-write", "max_rounds": 1000},
    {"action": "assert_response", "label": "healthy-write", "equals": {"txn_id": "late-release-write", "status": "COMMITTED"}},
    {"action": "request", "label": "healthy-write-repeat", "request": {"op": "txn", "txn_id": "late-release-write", "delta_map": {"a": 1}}},
    {"action": "await", "label": "healthy-write-repeat", "max_rounds": 1000},
    {"action": "assert_response", "label": "healthy-write-repeat", "equals": {"txn_id": "late-release-write", "status": "COMMITTED"}},
    {"action": "request", "label": "final", "request": {"op": "snapshot", "read_id": "late-release-final", "keys": ["a", "b", "c"]}},
    {"action": "await", "label": "final", "max_rounds": 1000},
    {"action": "assert_values", "label": "final", "equals": {"a": 101, "b": 100, "c": 0}}
  ]
}
